{
  "dataset_id": "crm_contacts_api",
  "source_type": "rest",
  "enabled": false,
  "connection": "conn_crm_api",
  "rest": {
    "endpoint": "/v1/contacts",
    "load_mode": "incremental",
    "watermark_column": "updated_at",
    "watermark_param": "updated_since",
    "pagination": {
      "style": "page",
      "page_param": "page",
      "size_param": "per_page",
      "page_size": 500
    },
    "records_path": "data"
  },
  "additional_config": {
    "note": "TEMPLATE for a bearer-token API. Set enabled=true and store the token in Key Vault under secret_name."
  }
}
